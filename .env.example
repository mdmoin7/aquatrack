VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Society tenant ID (single-society deployment)
VITE_SOCIETY_ID=default

# Comma-separated emails that auto-receive superadmin on sign-in
VITE_SUPERADMIN_EMAILS=your-email@example.com

# Set to true to use Firebase emulators in development
VITE_USE_FIREBASE_EMULATOR=false

# Leave Firebase vars empty to run in demo mode with localStorage
