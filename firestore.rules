rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function isBootstrapSuperAdmin() {
      return isSignedIn() && authEmail() == 'mohammad.nicoll@gmail.com';
    }

    function isGuestReader() {
      return !isSignedIn();
    }

    function canReadSociety(societyId) {
      return isGuestReader() || sameSociety(societyId);
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return hasProfile() && userDoc().role == 'superadmin';
    }

    function isAdmin() {
      return hasProfile() && userDoc().role in ['admin', 'superadmin'];
    }

    function isResident() {
      return hasProfile() && userDoc().role == 'resident';
    }

    function isMeterReader() {
      return hasProfile() && userDoc().role == 'meter_reader';
    }

    function flatBlock(societyId, flatId) {
      return get(/databases/$(database)/documents/societies/$(societyId)/flats/$(flatId)).data.block;
    }

    function meterReaderCanAccessFlat(societyId, flatId) {
      return isMeterReader() &&
        flatBlock(societyId, flatId) in userDoc().get('assignedBlocks', []);
    }

    function canWriteReading(societyId, flatId) {
      return isAdmin() ||
        (isResident() && flatId == residentFlatId()) ||
        meterReaderCanAccessFlat(societyId, flatId);
    }

    function canReadReading(societyId, flatId) {
      return isAdmin() ||
        isMeterReader() ||
        (isResident() && flatId == residentFlatId());
    }

    function sameSociety(societyId) {
      return hasProfile() && userDoc().societyId == societyId;
    }

    function residentFlatId() {
      return userDoc().flatId;
    }

    function canAssignRole(role) {
      return role != 'superadmin' || isSuperAdmin() || isBootstrapSuperAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (
        (request.auth.uid == userId &&
          canAssignRole(request.resource.data.role)) ||
        (isAdmin() &&
          request.resource.data.societyId == userDoc().societyId &&
          canAssignRole(request.resource.data.role))
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role) ||
        (isAdmin() &&
          resource.data.societyId == userDoc().societyId &&
          (resource.data.role != 'superadmin' || isSuperAdmin()) &&
          canAssignRole(request.resource.data.role))
      );
    }

    // Society-scoped data
    match /societies/{societyId} {

      match /flats/{flatId} {
        allow read: if canReadSociety(societyId);
        allow write: if sameSociety(societyId) && isAdmin();
      }

      match /readings/{readingId} {
        allow read: if isGuestReader() || (sameSociety(societyId) && (
          canReadReading(societyId, resource.data.flatId)
        ));
        allow create: if sameSociety(societyId) && (
          canWriteReading(societyId, request.resource.data.flatId)
        );
        allow update: if sameSociety(societyId) && (
          canWriteReading(societyId, resource.data.flatId) &&
          request.resource.data.flatId == resource.data.flatId
        );
        allow delete: if sameSociety(societyId) && isAdmin();
      }

      match /billingConfigs/{month} {
        allow read: if canReadSociety(societyId);
        allow create, update: if sameSociety(societyId) && isAdmin();
        allow delete: if sameSociety(societyId) && isAdmin();
      }

      match /flatBills/{billId} {
        allow read: if canReadSociety(societyId);
        allow create, update: if sameSociety(societyId) && isAdmin();
        allow delete: if sameSociety(societyId) && isAdmin();
      }

      match /alerts/{alertId} {
        function alertAudience() {
          return resource.data.get('audience', 'flat');
        }

        function meterReaderCanUpsertAlert(flatId) {
          return isMeterReader() && (
            flatId == 'society' ||
            meterReaderCanAccessFlat(societyId, flatId)
          );
        }

        allow read: if sameSociety(societyId) && (
          (alertAudience() == 'superadmin' && isSuperAdmin()) ||
          (alertAudience() != 'superadmin' && (
            isAdmin() ||
            (isResident() && resource.data.flatId == residentFlatId()) ||
            (isMeterReader() && meterReaderCanAccessFlat(societyId, resource.data.flatId))
          ))
        );
        allow create: if sameSociety(societyId) && (
          isAdmin() ||
          meterReaderCanUpsertAlert(request.resource.data.flatId)
        );
        allow update: if sameSociety(societyId) && (
          isAdmin() ||
          (isResident() &&
            resource.data.flatId == residentFlatId() &&
            request.resource.data.acknowledged == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged'])) ||
          meterReaderCanUpsertAlert(resource.data.flatId)
        );
        allow delete: if sameSociety(societyId) && isAdmin();
      }

      match /tankerDeliveries/{deliveryId} {
        allow read, write: if sameSociety(societyId) && isAdmin();
      }

      match /tankerVendors/{vendorId} {
        allow read: if sameSociety(societyId);
        allow write: if sameSociety(societyId) && isAdmin();
      }

      match /expenses/{expenseId} {
        allow read: if sameSociety(societyId);
        allow write: if sameSociety(societyId) && isAdmin();
      }

      match /expenseProvisions/{month} {
        allow read: if sameSociety(societyId);
        allow write: if sameSociety(societyId) && isAdmin();
      }

      match /fundCollections/{collectionId} {
        allow read: if sameSociety(societyId);
        allow write: if sameSociety(societyId) && isAdmin();
      }
    }
  }
}
